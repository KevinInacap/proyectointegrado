# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Sistema de Gestión de Resultados (SGR) — Ilustre Municipalidad de La Serena
# Evaluación Sumativa II: Programación Back End (TI3041)
# ==============================================================================

DEBUG=True
SECRET_KEY=django-insecure-sgr-eval2-secret-key-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS (PORTABILIDAD MULTIENTORNO)
# ------------------------------------------------------------------------------
# MODO A: SQLite (Recomendado para revisión en laboratorio - Cero dependencias externas)
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3

# MODO B: MySQL / MariaDB (Compatible con WampServer o XAMPP)
# Para activar MySQL en WampServer:
#  1. Inicie WampServer (icono en verde en la bandeja del sistema).
#  2. En phpMyAdmin (http://localhost/phpmyadmin/), cree la base de datos: sgr_municipal
#  3. Cambie DB_ENGINE=mysql y ajuste los parámetros:
# DB_ENGINE=mysql
# DB_NAME=sgr_municipal
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
