# Configuración General del Entorno Django
DEBUG=True
# Solo desarrollo local; usar una clave aleatoria privada al desplegar.
SECRET_KEY=django-insecure-sgr-local-development-only-change-before-deployment
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Configuración de Base de Datos
# Opciones para DB_ENGINE: sqlite3 (por defecto para entorno de pruebas/laboratorio) o mysql
DB_ENGINE=sqlite3

# Con SQLite, DB_NAME es el nombre del archivo local. Para MySQL, cambiarlo a sgr_municipal.
DB_NAME=db.sqlite3
# Los siguientes parámetros solo se usan con DB_ENGINE=mysql.
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo de recuperación: configurar en el servidor, nunca subir la clave.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
